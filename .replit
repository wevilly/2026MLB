modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
# A frozen-lockfile install on a cold pnpm store, plus pre-push migrations, a
# full schema push and 121 immutability statements, does not reliably fit in
# three minutes. A postMerge that is killed mid-push leaves the schema half
# applied, which is the state this hook exists to prevent.
timeoutMs = 600000

[nix]
channel = "stable-25_05"

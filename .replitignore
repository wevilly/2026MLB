# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# Working material. None of it is an input to the build, and none of it belongs
# in a deployed image. See docs/repository-inventory.md for the assessment.
attached_assets
screenshots
reports

# Test fixtures and acceptance suites are not deployed.
tests
